# AI provider: gemini or openai
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_POOL=gemini-2.5-flash,gemma-3-1b-it,gemma-3-4b-it,gemma-3-12b-it,gemma-3-27b-it,gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_MODEL=

# OpenAI, optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Research mode: browser or api.
# browser uses Playwright with priority: Google -> Bing -> DuckDuckGo.
# api uses Google Custom Search JSON API.
RESEARCH_MODE=browser
SEARCH_ENGINES=google,bing,duckduckgo
BROWSER_HEADLESS=false
SEARCH_WAIT_MS=2500
PAGE_WAIT_MS=1500
SEARCH_PAGE_TIMEOUT_MS=20000
SOURCE_PAGE_TIMEOUT_MS=20000
BROWSER_MAX_CANDIDATES=12
SEARCH_DAYS=30
SEARCH_RESULTS_PER_TOPIC=8
IMAGE_RESULTS_PER_TOPIC=3

# Optional Google Programmable Search / Custom Search JSON API.
# Only needed when RESEARCH_MODE=api or --research=api.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# WordPress REST API
# Use an Application Password from WordPress Admin -> Users -> Profile.
WP_BASE_URL=https://healingpoint.in/
WP_USERNAME=ashish
WP_APP_PASSWORD=DRWR GatP VB27 3UAL fu1r Vr32
WP_DEFAULT_CATEGORY_NAME=AI World


# draft is safest. Change to publish only when ready.
WP_POST_STATUS=publish

# Optional defaults
WP_DEFAULT_CATEGORY_IDS=
WP_DEFAULT_CATEGORY_NAME=AI World
WP_DEFAULT_TAG_IDS=
ARTICLE_LIMIT=0
AUTO_UPLOAD_IMAGES=true
